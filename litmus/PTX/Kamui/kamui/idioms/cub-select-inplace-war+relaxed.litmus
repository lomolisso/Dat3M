PTX cub-select-inplace-war+relaxed
{
x=1;
f=0;
s=0 @cta 0;
P0:r0=0;
P1:r3=0;
P1:r4=0;
P1:r5=0;
P2:r1=0;
P2:r2=0;
}
 P0@cta 0,cluster 0,gpu 0  | P1@cta 0,cluster 0,gpu 0  | P2@cta 1,cluster 0,gpu 0 ;
 ld.weak.global r0, x      | bar.sync 1, 2             | ld.relaxed.gpu r1, f     ;
 st.weak.shared::cta s, r0 | ld.weak.shared::cta r3, s | add r2, r1, 1            ;
 bar.sync 1, 2             | mul r4, r3, 0             | st.weak.global x, r2     ;
                           | add r5, r4, 1             |                          ;
                           | st.relaxed.gpu f, r5      |                          ;
exists
(P0:r0 == 2 /\ P2:r1 == 1)
