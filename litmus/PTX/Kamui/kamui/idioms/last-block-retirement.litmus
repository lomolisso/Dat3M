PTX last-block-retirement
{
p0=0;
p1=0;
n=0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,gpu 0                 | P1@cta 1,gpu 0                 ;
 st.weak.global p0, 1           | st.weak.global p1, 1           ;
 fence.sc.gpu                   | fence.sc.gpu                   ;
 atom.relaxed.gpu.add r0, n, 1  | atom.relaxed.gpu.add r0, n, 1  ;
                                | ld.weak.global r1, p0          ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
