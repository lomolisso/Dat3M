PTX cccl-bulk-copy-then-expect-tx
{
g=5;
d=0 @cta 0;
b=mbarrier(2) @cta 0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0                                                  | P1@cta 0,cluster 0,gpu 0                       ;
 cp.async.bulk.shared::cluster.global.mbarrier::complete_tx::bytes d, g, b | mbarrier.arrive.release.cta b                  ;
 mbarrier.expect_tx.relaxed.cta b, 1                                       | mbarrier.test_wait.parity.acquire.cta r0, b, 0 ;
 mbarrier.arrive.release.cta b                                             | ld.weak.shared::cta r1, d                      ;
exists
(P1:r0 == 1 /\ P1:r1 != 5)
