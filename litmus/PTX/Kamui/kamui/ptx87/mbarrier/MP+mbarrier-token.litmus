PTX MP+mbarrier-token
{
b=mbarrier(2) @cta 0;
x=0;
P0:r0=0;
P0:r1=0;
P0:r2=0;
}
 P0@cta 0,cluster 0,gpu 0                 | P1@cta 0,cluster 0,gpu 0      ;
 mbarrier.arrive.release.cta r0, b        | st.weak x, 1                  ;
 mbarrier.test_wait.acquire.cta r1, b, r0 | mbarrier.arrive.release.cta b ;
 ld.weak r2, x                            |                               ;
exists
(P0:r1 == 1 /\ P0:r2 == 0)
