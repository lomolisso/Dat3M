PTX MP+mbarrier.complete_tx.cluster+local
{
b=mbarrier(1) @cta 0;
x=0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0                  | P1@cta 0,cluster 0,gpu 0                           ;
 st.weak x, 1                              | mbarrier.arrive.expect_tx.release.cluster b, 1     ;
 mbarrier.complete_tx.relaxed.cluster b, 1 | mbarrier.test_wait.parity.acquire.cluster r0, b, 0 ;
                                           | ld.weak r1, x                                      ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
