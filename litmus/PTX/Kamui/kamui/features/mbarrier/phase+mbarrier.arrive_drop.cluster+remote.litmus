PTX phase+mbarrier.arrive_drop.cluster+remote
{
b=mbarrier(2) @cta 1;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0                               | P1@cta 1,cluster 0,gpu 0                           ;
 mbarrier.arrive_drop.relaxed.cluster.shared::cluster b | mbarrier.test_wait.parity.relaxed.cluster r0, b, 0 ;
                                                        | mbarrier.arrive.relaxed.cluster b                  ;
                                                        | mbarrier.test_wait.parity.relaxed.cluster r1, b, 1 ;
exists
(P1:r0 == 0 /\ P1:r1 == 1)
