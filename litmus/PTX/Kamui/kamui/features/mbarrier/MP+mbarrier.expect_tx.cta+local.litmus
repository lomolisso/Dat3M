PTX MP+mbarrier.expect_tx.cta+local
{
b=mbarrier(2) @cta 0;
x=0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0              | P1@cta 0,cluster 0,gpu 0                       ;
 st.weak x, 1                          | mbarrier.expect_tx.relaxed.cta b, 1            ;
 mbarrier.complete_tx.relaxed.cta b, 1 | mbarrier.test_wait.parity.acquire.cta r0, b, 0 ;
 mbarrier.arrive.release.cta b         | ld.weak r1, x                                  ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
