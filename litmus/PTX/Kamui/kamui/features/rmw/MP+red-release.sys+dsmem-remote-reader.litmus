PTX MP+red-release.sys+dsmem-remote-reader
{
x=0 @cta 0;
f=0 @cta 0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0             | P1@cta 1,cluster 0,gpu 0             ;
 st.weak.shared::cta x, 1             | ld.acquire.sys.shared::cluster r0, f ;
 red.release.sys.shared::cta.add f, 1 | ld.weak.shared::cluster r1, x        ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
