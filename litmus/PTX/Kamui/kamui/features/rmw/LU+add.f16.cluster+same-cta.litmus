PTX LU+add.f16.cluster+same-cta
{
x=0;
P0:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0                           | P1@cta 0,cluster 0,gpu 0                           ;
 atom.relaxed.cluster.global.add.noftz.f16 r0, x, 1 | atom.relaxed.cluster.global.add.noftz.f16 r1, x, 1 ;
exists
(P0:r0 == 0 /\ P1:r1 == 0)
