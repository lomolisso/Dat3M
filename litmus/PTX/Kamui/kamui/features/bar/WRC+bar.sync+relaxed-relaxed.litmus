PTX WRC+bar.sync+relaxed-relaxed
{
x=0;
f=0;
P2:r0=0;
P2:r1=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 0,cluster 0,gpu 0 | P2@cta 0,cluster 0,gpu 0 ;
 st.weak x, 1             | bar.sync 0               | ld.relaxed.cta r0, f     ;
 bar.sync 0               | st.relaxed.cta f, 1      | ld.weak r1, x            ;
exists
(P2:r0 == 1 /\ P2:r1 == 0)
