PTX SB+barrier.sync.3+global
{
x=0;
y=0;
P0:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 0,cluster 0,gpu 0 ;
 st.weak x, 1             | st.weak y, 1             ;
 barrier.sync 3           | barrier.sync 3           ;
 ld.weak r0, y            | ld.weak r1, x            ;
exists
(P0:r0 == 0 \/ P1:r1 == 0)
