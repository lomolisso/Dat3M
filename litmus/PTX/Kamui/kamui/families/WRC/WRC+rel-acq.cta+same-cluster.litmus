PTX WRC+rel-acq.cta+same-cluster
{
x=0;
y=0;
P1:r0=0;
P2:r1=0;
P2:r2=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 1,cluster 0,gpu 0 | P2@cta 2,cluster 0,gpu 0 ;
 st.relaxed.cta x, 1      | ld.relaxed.cta r0, x     | ld.acquire.cta r1, y     ;
                          | st.release.cta y, 1      | ld.relaxed.cta r2, x     ;
exists
(P1:r0 == 1 /\ P2:r1 == 1 /\ P2:r2 == 0)
