PTX WRC+fence-sc.cluster+same-cluster
{
x=0;
y=0;
P1:r0=0;
P2:r1=0;
P2:r2=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 1,cluster 0,gpu 0 | P2@cta 2,cluster 0,gpu 0 ;
 st.relaxed.cluster x, 1  | ld.relaxed.cluster r0, x | ld.relaxed.cluster r1, y ;
                          | fence.sc.cluster         | fence.sc.cluster         ;
                          | st.relaxed.cluster y, 1  | ld.relaxed.cluster r2, x ;
exists
(P1:r0 == 1 /\ P2:r1 == 1 /\ P2:r2 == 0)
