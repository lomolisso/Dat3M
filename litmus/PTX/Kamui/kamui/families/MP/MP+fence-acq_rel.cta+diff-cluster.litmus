PTX MP+fence-acq_rel.cta+diff-cluster
{
x=0;
y=0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 1,cluster 1,gpu 0 ;
 st.weak x, 1             | ld.relaxed.cta r0, y     ;
 fence.acq_rel.cta        | fence.acq_rel.cta        ;
 st.relaxed.cta y, 1      | ld.weak r1, x            ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
