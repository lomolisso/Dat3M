PTX ISA2+rel-acq.cluster+same-cluster
{
x=0;
y=0;
z=0;
P1:r0=0;
P2:r1=0;
P2:r2=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 1,cluster 0,gpu 0 | P2@cta 2,cluster 0,gpu 0 ;
 st.weak x, 1             | ld.acquire.cluster r0, y | ld.acquire.cluster r1, z ;
 st.release.cluster y, 1  | st.release.cluster z, 1  | ld.weak r2, x            ;
exists
(P1:r0 == 1 /\ P2:r1 == 1 /\ P2:r2 == 0)
