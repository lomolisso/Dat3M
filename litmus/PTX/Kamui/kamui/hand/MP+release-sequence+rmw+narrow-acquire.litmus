PTX MP+release-sequence+rmw+narrow-acquire
{
x=0;
f=0;
P1:r0=0;
P2:r1=0;
P2:r2=0;
}
 P0@cta 0,gpu 0       | P1@cta 1,gpu 0                | P2@cta 0,gpu 0        ;
 st.weak x, 1         | atom.relaxed.gpu.add r0, f, 1 | ld.acquire.cta r1, f  ;
 st.release.gpu f, 1  |                               | ld.weak r2, x         ;
exists
(P1:r0 == 1 /\ P2:r1 == 2 /\ P2:r2 == 0)
