PTX MP+release-sequence+mixed-size
{
y=0;
x[0]=0;
x[1]=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0   | P1@cta 1,cluster 0,gpu 0  ;
 st.weak y, 1               | ld.acquire.gpu.b32 r0, x  ;
 st.release.gpu.b32 x, 1    | ld.weak r1, y             ;
 st.relaxed.gpu.b32 x, 2    |                           ;
exists
(P1:r0[0] == 2 /\ P1:r0[1] == 2 /\ P1:r1 == 0)
