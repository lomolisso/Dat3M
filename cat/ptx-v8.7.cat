PTX
(* NVIDIA. Parallel Thread Execution ISA Version 8.7, chapter 8 (Memory Consistency Model) *)

// The choices this model makes where the manual leaves room for interpretation are described in ptx-v8.7.md
// (entries M1, M2, ...). The definitions are in ptx-v8.7-common.cat.

include "ptx-v8.7-common.cat"

(* Undefined behaviour is reported, not modelled: the axioms still apply to the execution.
   - 8.7.2: the axioms do not apply to a program with a mixed-size data race. Whether a program has one is a
     question about all its executions; it is checked with --property=cat_spec, and the program is then decided
     with ptx-v8.7-noaxioms.cat (M16).
   - UB: an event executed only after a misuse (e.g. an operation on an invalid mbarrier object, M35);
     UB_STATIC: undefined behaviour visible in the program text (a missing wgmma.fence, M51). *)
flag ~empty mixed-size-race as mixed-size-data-race
flag ~empty ([UB] | [UB_STATIC]) as undefined-behaviour

(******************************)
(*  PTX Memory Model Axioms   *)
(******************************)

(* 8.10.1 Coherence *)
empty ((([W]; cause; [W]) & loc) \ co) as axiom-Coherence
// Morally strong overlapping writes are related by coherence order (8.9.6)
empty ((([W]; morally-strong; [W]) & loc) \ (co | co^-1)) as axiom-Coherence2
// Coherence order relates write operations: a morally strong pair of writes to several granules is ordered the
// same way on all of them (M15)
let ms-co = morally-strong & co
irreflexive (ms-co; si; ms-co; si) as axiom-Coherence-granules

(* 8.10.2 Fence-SC: causality order between fences is base causality order (M5) *)
empty ((([F & SC]; cause-base; [F & SC]) & morally-strong) \ sync_fence) as axiom-FenceSC

(* 8.10.3 Atomicity *)
// Single-copy atomicity: a read does not read some granules from a morally strong write and others from
// writes that precede it in coherence order (M15)
irreflexive ((morally-strong & fr); si; (morally-strong & rf); si) as axiom-SingleCopyAtomicity
// Atomicity of read-modify-write operations
empty (((morally-strong & fr); (morally-strong & co)) & rmw) as axiom-Atomicity
// 8.7.2: overlapping atomic operations whose scopes include each other are atomic also when they overlap
// partially (M17)
empty (((atomic-pair & fr); [range(rmw)]; (atomic-pair & co)) & rmw) as axiom-MixedSizeAtomicity

(* 8.10.4 No-Thin-Air *)
let dep = addr | data | ctrl
acyclic (rf | dep) as axiom-NoThinAir

(* 8.10.5 Sequential consistency per location, for morally strong operations (M7) *)
acyclic (morally-strong & (po | rf | co | fr) & vloc) as axiom-ScPerLocation

(* 8.10.6 Causality *)
irreflexive ((rf | fr); cause) as axiom-Causality
